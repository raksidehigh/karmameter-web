generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Admin ────────────────────────────────────────────────────────────────────

model AdminUser {
  id            String   @id @default(cuid())
  email         String   @unique
  passwordHash  String
  totpSecret    String?  // null until TOTP is set up
  totpVerified  Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("admin_users")
}

// ─── Core Entities ────────────────────────────────────────────────────────────

model Party {
  id           String      @id @default(cuid())
  name         String      @unique
  abbreviation String
  symbolUrl    String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  politicians  Politician[]

  @@map("parties")
}

model Constituency {
  id         String             @id @default(cuid())
  name       String
  state      String             // e.g. "Goa", "Punjab"
  type       ConstituencyType
  population BigInt?
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  politicians Politician[]
  budgets     Budget[]
  projects    Project[]

  @@unique([name, state, type])
  @@map("constituencies")
}

model Politician {
  id             String       @id @default(cuid())
  fullName       String
  dateOfBirth    DateTime?
  partyId        String?
  constituencyId String?
  position       String       // "MP", "MLA", "Minister", etc.
  electionYear   Int?
  totalAssets    Decimal?
  criminalCases  Int          @default(0)
  education      String?
  photoUrl       String?
  sourceUrl      String?      // affidavit / ECI source
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  party        Party?        @relation(fields: [partyId], references: [id])
  constituency Constituency? @relation(fields: [constituencyId], references: [id])

  projects    Project[]
  promises    Promise[]
  attendance  Attendance[]
  scores      Score[]
  auditLogs   AuditLog[]

  @@map("politicians")
}

// ─── Data Models ──────────────────────────────────────────────────────────────

model Budget {
  id             String   @id @default(cuid())
  constituencyId String
  financialYear  String   // e.g. "2023-24"
  allocatedAmount Decimal
  spentAmount    Decimal?
  sourceUrl      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  constituency Constituency @relation(fields: [constituencyId], references: [id])

  @@map("budgets")
}

model Project {
  id                   String        @id @default(cuid())
  title                String
  description          String?
  constituencyId       String
  politicianId         String?
  allocatedBudget      Decimal?
  status               ProjectStatus @default(PLANNED)
  startDate            DateTime?
  endDate              DateTime?
  completionPercentage Float?
  sourceUrl            String?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  constituency Constituency @relation(fields: [constituencyId], references: [id])
  politician   Politician?  @relation(fields: [politicianId], references: [id])

  @@map("projects")
}

model Promise {
  id          String        @id @default(cuid())
  politicianId String
  description String
  category    String?
  status      PromiseStatus @default(NOT_STARTED)
  evidenceUrl String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  politician Politician @relation(fields: [politicianId], references: [id])

  @@map("promises")
}

model Attendance {
  id                   String   @id @default(cuid())
  politicianId         String
  sessionYear          String
  attendancePercentage Float
  sourceUrl            String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  politician Politician @relation(fields: [politicianId], references: [id])

  @@map("attendance_records")
}

// ─── Scores (computed, not raw) ───────────────────────────────────────────────

model Score {
  id              String   @id @default(cuid())
  politicianId    String
  overallScore    Float
  promiseScore    Float?
  attendanceScore Float?
  budgetScore     Float?
  criminalPenalty Float?
  formulaVersion  String   @default("v1")
  lastComputedAt  DateTime @default(now())

  politician Politician @relation(fields: [politicianId], references: [id])

  @@unique([politicianId, formulaVersion])
  @@map("scores")
}

// ─── Audit Log ────────────────────────────────────────────────────────────────

model AuditLog {
  id          String   @id @default(cuid())
  entityType  String   // "Politician", "Score", etc.
  entityId    String
  action      AuditAction
  changedBy   String   // admin email
  oldData     Json?
  newData     Json?
  timestamp   DateTime @default(now())

  politician  Politician? @relation(fields: [entityId], references: [id], map: "audit_politician_fk")

  @@map("audit_logs")
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum ConstituencyType {
  LOK_SABHA
  VIDHAN_SABHA
}

enum ProjectStatus {
  PLANNED
  ONGOING
  COMPLETED
  DELAYED
}

enum PromiseStatus {
  NOT_STARTED
  IN_PROGRESS
  FULFILLED
  BROKEN
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  RECOMPUTE
}

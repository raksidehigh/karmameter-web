generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Admin ────────────────────────────────────────────────────────────────────

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  totpSecret   String?
  totpVerified Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("admin_users")
}

// ─── Geography ────────────────────────────────────────────────────────────────

model Country {
  id        String   @id @default(cuid())
  name      String   @unique
  code      String   @unique // ISO 3166-1 alpha-2, e.g. "IN", "US"
  flagUrl   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  states         State[]
  parties        Party[]
  electionTypes  ElectionType[]

  @@map("countries")
}

model State {
  id        String   @id @default(cuid())
  name      String
  code      String?  // e.g. "MH", "CA"
  countryId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  country        Country        @relation(fields: [countryId], references: [id])
  constituencies Constituency[]

  @@unique([name, countryId])
  @@map("states")
}

// ─── Election Types ───────────────────────────────────────────────────────────

model ElectionType {
  id          String         @id @default(cuid())
  name        String         // "Lok Sabha", "Vidhan Sabha", "MCD", "Congressional"
  level       ElectionLevel  // NATIONAL, STATE, LOCAL
  countryId   String
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  country        Country        @relation(fields: [countryId], references: [id])
  constituencies Constituency[]

  @@unique([name, countryId])
  @@map("election_types")
}

// ─── Constituencies ───────────────────────────────────────────────────────────

model Constituency {
  id             String   @id @default(cuid())
  name           String
  stateId        String
  electionTypeId String
  population     BigInt?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  state        State        @relation(fields: [stateId], references: [id])
  electionType ElectionType @relation(fields: [electionTypeId], references: [id])

  politicians Politician[]
  budgets     Budget[]
  projects    Project[]

  @@unique([name, stateId, electionTypeId])
  @@map("constituencies")
}

// ─── Parties ──────────────────────────────────────────────────────────────────

model Party {
  id           String   @id @default(cuid())
  name         String
  abbreviation String
  countryId    String
  symbolUrl    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  country     Country      @relation(fields: [countryId], references: [id])
  politicians Politician[]

  @@unique([name, countryId])
  @@map("parties")
}

// ─── Politicians ──────────────────────────────────────────────────────────────

model Politician {
  id             String   @id @default(cuid())
  fullName       String
  dateOfBirth    DateTime?
  partyId        String?
  constituencyId String?
  position       String   // "MP", "MLA", "Councillor", "Senator" etc.
  electionYear   Int?
  totalAssets    Decimal?
  criminalCases  Int      @default(0)
  education      String?
  photoUrl       String?  // Supabase Storage URL
  sourceUrl      String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  party        Party?        @relation(fields: [partyId], references: [id])
  constituency Constituency? @relation(fields: [constituencyId], references: [id])

  projects   Project[]
  promises   Promise[]
  attendance Attendance[]
  scores     Score[]

  @@map("politicians")
}

// ─── Data Models ──────────────────────────────────────────────────────────────

model Budget {
  id              String   @id @default(cuid())
  constituencyId  String
  financialYear   String
  allocatedAmount Decimal
  spentAmount     Decimal?
  sourceUrl       String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  constituency Constituency @relation(fields: [constituencyId], references: [id])

  @@map("budgets")
}

model Project {
  id                   String        @id @default(cuid())
  title                String
  description          String?
  constituencyId       String
  politicianId         String?
  allocatedBudget      Decimal?
  status               ProjectStatus @default(PLANNED)
  startDate            DateTime?
  endDate              DateTime?
  completionPercentage Float?
  sourceUrl            String?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  constituency Constituency @relation(fields: [constituencyId], references: [id])
  politician   Politician?  @relation(fields: [politicianId], references: [id])

  @@map("projects")
}

model Promise {
  id           String        @id @default(cuid())
  politicianId String
  description  String
  category     String?
  status       PromiseStatus @default(NOT_STARTED)
  evidenceUrl  String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  politician Politician @relation(fields: [politicianId], references: [id])

  @@map("promises")
}

model Attendance {
  id                   String   @id @default(cuid())
  politicianId         String
  sessionYear          String
  attendancePercentage Float
  sourceUrl            String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  politician Politician @relation(fields: [politicianId], references: [id])

  @@map("attendance_records")
}

// ─── Scores ───────────────────────────────────────────────────────────────────

model Score {
  id              String   @id @default(cuid())
  politicianId    String
  overallScore    Float
  promiseScore    Float?
  attendanceScore Float?
  budgetScore     Float?
  criminalPenalty Float?
  formulaVersion  String   @default("v1")
  lastComputedAt  DateTime @default(now())

  politician Politician @relation(fields: [politicianId], references: [id])

  @@unique([politicianId, formulaVersion])
  @@map("scores")
}

// ─── Audit Log ────────────────────────────────────────────────────────────────

model AuditLog {
  id         String      @id @default(cuid())
  entityType String
  entityId   String
  action     AuditAction
  changedBy  String
  oldData    Json?
  newData    Json?
  timestamp  DateTime    @default(now())

  @@map("audit_logs")
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum ElectionLevel {
  NATIONAL
  STATE
  LOCAL
}

enum ProjectStatus {
  PLANNED
  ONGOING
  COMPLETED
  DELAYED
}

enum PromiseStatus {
  NOT_STARTED
  IN_PROGRESS
  FULFILLED
  BROKEN
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  RECOMPUTE
}

# Copy this file to .env.local and replace the example values.
# Never put production credentials in this file or commit a real .env file.

# PostgreSQL connection strings used by Prisma.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/karmameter?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/karmameter?schema=public"

# Use a unique random value for local development (for example: openssl rand -base64 32).
JWT_SECRET="replace-with-a-random-local-secret"

# Used only when creating the first admin account; choose a local-only value.
ADMIN_SETUP_KEY="replace-with-a-local-setup-key"

# Supabase project settings used for politician image uploads.
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="replace-with-your-project-service-role-key"

# Optional: comma-separated IP addresses allowed to access /admin.
# ADMIN_IP_ALLOWLIST="127.0.0.1,::1"